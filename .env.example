# Copy this file to %USERPROFILE%\stock-radar-local\.env (outside OneDrive) and fill in your keys.
# Never commit the real .env. In GitHub these values go into Settings -> Secrets -> Actions.

TWELVEDATA_API_KEY=
EODHD_API_KEY=

# LLM: gemini (default, free tier) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-3.5-flash-lite  GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Optional: ANTHROPIC_MODEL=claude-opus-5-5 (default) or claude-haiku-5-5 (much cheaper)
# Optional: LLM_TIME_BUDGET=1200 (seconds for the whole AI step per run)
ANTHROPIC_API_KEY=

# Israel data source: yfinance (EODHD does not cover TASE; verified 2026-11-23)
IL_PRIMARY=yfinance
